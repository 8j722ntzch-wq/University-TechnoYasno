---
import {categories} from '../lib/data';
import {icon} from '../lib/ui';
import {content,pages} from '../lib/pages';
import '../style.css';
const {path,title}=Astro.props;
const actions=[['chart-no-axes-column','Сравнение','/compare/','compare'],['heart','Избранное','/favorites/','fav'],['user','Кабинет','#guest',''],['shopping-cart','Корзина','/cart/','cart']];
const nav=[['house','Главная','/'],['menu','Каталог','/catalog/'],['sliders-horizontal','Подбор','/finder/'],['heart','Избранное','/favorites/'],['shopping-cart','Корзина','/cart/']];
---
<!DOCTYPE html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="ТехноЯсно — демонстрационный магазин компьютерной техники. Подбор по задачам, сравнение и шоурум в Минске."/><meta name="robots" content="noindex, nofollow"/><link rel="icon" href="/favicon.svg"/><title>{title} · ТехноЯсно</title></head><body data-path={path}><a class="skip" href="#main">К содержанию</a><header><div class="top"><div class="wrap"><span><Fragment set:html={icon('map-pin')}/> Минск</span><nav><a href="/help/delivery-payment/">Доставка и оплата</a><a href="/business/">Для бизнеса</a><a href="/about/contacts/">Контакты</a></nav></div></div><div class="middle wrap"><a class="logo" href="/">техно<span>ясно.</span></a><a href="/about/showroom/" class="mobilecity"><Fragment set:html={icon('map-pin')}/> Минск</a><a href="#guest" class="mobileuser" aria-label="Кабинет"><Fragment set:html={icon('user')}/></a><a class="catalog-btn btn primary" href="/catalog/"><Fragment set:html={icon('menu')}/>Каталог</a><form action="/search/" class="search"><button aria-label="Искать"><Fragment set:html={icon('search')}/></button><input type="search" name="q" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-options" autocomplete="off" aria-label="Поиск техники" placeholder="Поиск по модели, артикулу или характеристикам" required maxlength="100"/><div class="suggestions" hidden><div id="search-options" role="listbox" aria-label="Найденные товары"></div><button type="submit">Все результаты поиска →</button></div></form><nav class="actions">{actions.map(([i,l,u,k])=><a href={u}><Fragment set:html={icon(i)}/><span>{l}</span>{k&&<em data-count={k}></em>}</a>)}</nav></div><nav class="navwrap"><div class="wrap">{Object.entries(categories).map(([k,v])=><a class:list={[path==='catalog/'+k&&'current']} href={'/catalog/'+k+'/'}>{v}</a>)}<a class="current" href="/finder/">Подбор ноутбука</a><a href="/offers/">Акции</a></div></nav></header><main id="main" class="wrap" set:html={content(path)}></main><footer><div class="wrap"><div><a class="logo" href="/">техно<span>ясно.</span></a><p>Выгодно онлайн. Уверенно офлайн.</p></div><nav>{['catalog','finder','compare','about/showroom','business','offers','help/delivery-payment','help/warranty-returns','about/contacts'].map(k=><a href={'/'+k+'/'}>{pages[k]}</a>)}</nav><small>Учебный демонстрационный проект. Покупки не осуществляются. Данные товаров, цены, отзывы и изображения иллюстративные.</small></div></footer><nav class="bottom" aria-label="Мобильная навигация">{nav.map(([i,l,u])=><a class:list={[(u==='/'?!path:('/'+path+'/').startsWith(u))&&'current']} href={u}><Fragment set:html={icon(i)}/>{l}{u==='/cart/'&&<em data-count="cart"></em>}</a>)}</nav><dialog id="modal"><button class="iconbtn close" aria-label="Закрыть" data-close><Fragment set:html={icon('x')}/></button><div id="modalbody"></div></dialog><div id="toast" role="status"></div><script>import '../lib/client';</script></body></html>
